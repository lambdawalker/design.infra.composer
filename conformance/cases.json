  {
    "id": "state-allowlist",
    "input": {
      "op": "state",
      "state": {
        "deployment": {
          "resources": [
            {
              "type": "aws:lambda/function:Function",
              "urn": "urn:pulumi:dev::example::aws:lambda/function:Function::handler",
              "custom": true,
              "id": "handler-123",
              "inputs": {
                "timeout": 15
              },
              "outputs": {
                "memorySize": 256,
                "timeout": {
                  "secret": "fixture"
                },
                "environment": {
                  "API_KEY": "fixture"
                }
              }
            }
          ]
        }
      }
    },
    "expected": {
      "schemaVersion": 1,
      "scope": {},
      "metadata": {
        "startedAt": "0001-01-01T00:00:00Z",
        "finishedAt": "0001-01-01T00:00:00Z"
      },
      "cacheLoaded": false,
      "artifacts": [
        {
          "key": "urn:pulumi:dev::example::aws:lambda/function:Function::handler",
          "name": "handler",
          "type": "aws:lambda/function:Function",
          "provider": "aws",
          "providerId": "handler-123",
          "priority": 30,
          "observation": {
            "status": "recorded",
            "source": "pulumi-state",
            "observedAt": "2026-01-01T00:00:00Z"
          },
          "configuration": {
            "source": "pulumi-state",
            "observedAt": "2026-01-01T00:00:00Z",
            "values": {
              "memorySize": "256"
            }
          }
        }
      ]
    }
  },
  {
    "id": "stronger-controls",
    "input": {
      "op": "selectSource",
      "declaration": {
        "environment": "dev",
        "policyVersion": "v1",
        "properties": [
          {
            "name": "url",
            "type": "string",
            "category": "application",
            "sensitivity": "public",
            "required": true
          }
        ],
        "consumers": [
          {
            "artifact": "handler",
            "property": "url",
            "readers": [
              "remote"
            ]
          }
        ],
        "bindings": [
          {
            "artifact": "handler",
            "property": "url",
            "auto": true,
            "sources": [
              {
                "name": "first",
                "storage": "secret-store",
                "reader": "remote",
                "location": "config",
                "key": "url",
                "scope": "dev",
                "readerIdentity": "handler-role",
                "writerIdentity": "worker",
                "updateMethod": "versioned-write",
                "controls": [
                  "scoped"
                ],
                "maxStalenessSeconds": 30,
                "providerRank": 1,
                "costKnown": true,
                "estimatedCost": 1
              },
              {
                "name": "second",
                "storage": "secret-store",
                "reader": "remote",
                "location": "config",
                "key": "url",
                "scope": "dev",
                "readerIdentity": "handler-role",
                "writerIdentity": "worker",
                "updateMethod": "versioned-write",
                "controls": [
                  "scoped",
                  "encrypted"
                ],
                "maxStalenessSeconds": 30,
                "providerRank": 5,
                "costKnown": true,
                "estimatedCost": 9
              }
            ],
            "onMissing": "error",
            "onUnavailable": "error"
          }
        ]
      }
    },
    "expected": "second"
  },
