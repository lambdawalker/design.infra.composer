  {
    "id": "integrated-qa",
    "input": {
      "op": "plan",
      "scenario": "integrated",
      "environment": "qa"
    },
    "expected": {
      "order": [
        "authentication.pool",
        "emailvalidation.validator"
      ],
      "bindings": [
        {
          "consumer": "authentication.email-validator",
          "provider": "emailvalidation.validator",
          "contract": "example.email-validator/v1",
          "origin": "automatic"
        },
        {
          "consumer": "emailvalidation.users",
          "provider": "authentication.users",
          "contract": "example.user-pool/v1",
          "origin": "automatic"
        }
      ],
      "runtime_dependencies": [
        {
          "consumer": "authentication.email-validator",
          "provider": "emailvalidation.validator",
          "reason": "validate email when users register",
          "source": "examples/authentication"
        }
      ]
    }
  },
